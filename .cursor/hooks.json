{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/shell-permissions.py",
        "matcher": "git\\s+.*\\bpush\\b|\\brm\\b|\\brmdir\\b|\\bunlink\\b",
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/compile-on-edit.py",
        "matcher": "Write|StrReplace",
        "timeout": 200
      }
    ]
  }
}
