{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/shell-permissions.py",
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "python3 .cursor/hooks/compile-on-edit.py",
        "matcher": "Write|StrReplace",
        "timeout": 200
      }
    ]
  }
}
